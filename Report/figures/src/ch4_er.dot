digraph er {
  graph [layout=neato, fontname="Helvetica", fontsize=10, pad=0.05, splines=polyline];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=10, color="#444444", dir=both, arrowtail=crow, arrowhead=tee, arrowsize=0.8];
  sessions [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" color="#444444"><tr><td bgcolor="#a6a6a6"><b>sessions</b></td></tr><tr><td align="left" bgcolor="#ffffff"><b>id</b> PK</td></tr><tr><td align="left" bgcolor="#ffffff">name, video_path, gps_path</td></tr><tr><td align="left" bgcolor="#ffffff">started_utc, duration_s</td></tr><tr><td align="left" bgcolor="#ffffff">device, median_accuracy_m</td></tr><tr><td align="left" bgcolor="#ffffff">role: survey|tuning|test|demo</td></tr><tr><td align="left" bgcolor="#ffffff">gps_source: recorded|synthetic|none</td></tr><tr><td align="left" bgcolor="#ffffff">include_in_map, created_at</td></tr><tr><td align="left" bgcolor="#ffffff">active_job_id (no FK)</td></tr></table>>, pos="1.300,-1.010!"];
  gps_fixes [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" color="#444444"><tr><td bgcolor="#a6a6a6"><b>gps_fixes</b></td></tr><tr><td align="left" bgcolor="#ffffff"><b>session_id, seq</b> PK, FK</td></tr><tr><td align="left" bgcolor="#ffffff">t_video_s, lat, lon</td></tr><tr><td align="left" bgcolor="#ffffff">accuracy_m, speed_mps</td></tr><tr><td align="left" bgcolor="#ffffff">bearing_deg, utc_ms, used</td></tr></table>>, pos="1.300,-2.980!"];
  jobs [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" color="#444444"><tr><td bgcolor="#a6a6a6"><b>jobs</b></td></tr><tr><td align="left" bgcolor="#ffffff"><b>id</b> PK</td></tr><tr><td align="left" bgcolor="#ffffff">session_id FK</td></tr><tr><td align="left" bgcolor="#ffffff">status: queued|running|done|failed</td></tr><tr><td align="left" bgcolor="#ffffff">stage, progress, error</td></tr><tr><td align="left" bgcolor="#ffffff">pipeline_version, model_sha256</td></tr><tr><td align="left" bgcolor="#ffffff">params_json, summary_json</td></tr><tr><td align="left" bgcolor="#ffffff">created_at, updated_at</td></tr></table>>, pos="4.050,-0.902!"];
  observations [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" color="#444444"><tr><td bgcolor="#a6a6a6"><b>observations</b></td></tr><tr><td align="left" bgcolor="#ffffff"><b>id</b> PK; session_id FK; job_id FK</td></tr><tr><td align="left" bgcolor="#ffffff">UNIQUE(job_id, track_id)</td></tr><tr><td align="left" bgcolor="#ffffff">n_frames, confidence</td></tr><tr><td align="left" bgcolor="#ffffff">first_t_video_s, t_video_s</td></tr><tr><td align="left" bgcolor="#ffffff">frame_index, frame_w, frame_h</td></tr><tr><td align="left" bgcolor="#ffffff">image_path; x1, y1, x2, y2</td></tr><tr><td align="left" bgcolor="#ffffff">cam_lat, cam_lon, cam_accuracy_m</td></tr><tr><td align="left" bgcolor="#ffffff">edge_u, edge_v, edge_key,</td></tr><tr><td align="left" bgcolor="#ffffff">edge_offset_m, pothole_id FK</td></tr><tr><td align="left" bgcolor="#ffffff">(last five columns derived)</td></tr></table>>, pos="4.050,-3.410!"];
  edge_coverage [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" color="#444444"><tr><td bgcolor="#a6a6a6"><b>edge_coverage</b></td></tr><tr><td align="left" bgcolor="#ffffff"><b>id</b> PK; session_id FK; job_id FK</td></tr><tr><td align="left" bgcolor="#ffffff">edge_u, edge_v, edge_key</td></tr><tr><td align="left" bgcolor="#ffffff">start_m, end_m (start &lt;= end)</td></tr></table>>, pos="1.300,-4.412!"];
  builds [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" color="#444444"><tr><td bgcolor="#e3e3e3"><b>builds</b></td></tr><tr><td align="left" bgcolor="#ffffff"><b>id</b> PK; created_at</td></tr><tr><td align="left" bgcolor="#ffffff">pipeline_version</td></tr><tr><td align="left" bgcolor="#ffffff">graph_sha256 (NULL = no graph)</td></tr><tr><td align="left" bgcolor="#ffffff">params_json</td></tr></table>>, pos="1.300,-5.845!"];
  potholes [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" color="#444444"><tr><td bgcolor="#e3e3e3"><b>potholes</b></td></tr><tr><td align="left" bgcolor="#ffffff"><b>id</b> PK; build_id FK</td></tr><tr><td align="left" bgcolor="#ffffff">edge_u, edge_v, edge_key (nullable)</td></tr><tr><td align="left" bgcolor="#ffffff">edge_offset_m; lat, lon</td></tr><tr><td align="left" bgcolor="#ffffff">n_observations, n_sessions</td></tr><tr><td align="left" bgcolor="#ffffff">confidence</td></tr><tr><td align="left" bgcolor="#ffffff">gps_source: recorded|synthetic</td></tr><tr><td align="left" bgcolor="#ffffff">first_seen_utc, last_seen_utc</td></tr></table>>, pos="4.050,-5.917!"];
  edge_stats [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" color="#444444"><tr><td bgcolor="#e3e3e3"><b>edge_stats</b></td></tr><tr><td align="left" bgcolor="#ffffff"><b>edge_u, edge_v, edge_key</b> PK</td></tr><tr><td align="left" bgcolor="#ffffff">build_id FK</td></tr><tr><td align="left" bgcolor="#ffffff">length_m, surveyed_m</td></tr><tr><td align="left" bgcolor="#ffffff">n_potholes, rate_per_100m</td></tr></table>>, pos="4.050,-7.780!"];
  meta [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" color="#444444"><tr><td bgcolor="#e3e3e3"><b>meta</b></td></tr><tr><td align="left" bgcolor="#ffffff"><b>key</b> PK; value</td></tr><tr><td align="left" bgcolor="#ffffff">schema_version,</td></tr><tr><td align="left" bgcolor="#ffffff">include_synthetic, graph_sha256</td></tr></table>>, pos="1.300,-7.278!"];
  gps_fixes -> sessions;
  jobs -> sessions;
  observations -> sessions;
  observations -> jobs;
  edge_coverage -> sessions;
  edge_coverage -> jobs;
  potholes -> builds;
  edge_stats -> builds;
  observations -> potholes [label="set null"];
}